generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  writter
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(writter)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  diaries       Diary[]
  likes         Like[]
  comments      Comment[]
  bookmarks     Bookmark[]
  reports       Report[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum DiaryStatus {
  draft
  public
  private
}

enum DiaryModeration {
  none
  blocked
  revision
}

model Diary {
  id               Int             @id @default(autoincrement())
  title            String
  content          String
  mood             String?
  image            String?
  tags             String[]        @default([])
  status           DiaryStatus     @default(draft)
  moderationStatus DiaryModeration @default(none)
  authorId         String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes    Like[]
  comments Comment[]
  bookmarks Bookmark[]
  reports  Report[]
}

model Report {
  id        Int      @id @default(autoincrement())
  reason    String
  diaryId   Int
  userId    String
  createdAt DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Like {
  id        Int      @id @default(autoincrement())
  diaryId   Int
  userId    String
  createdAt DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([diaryId, userId])
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  diaryId   Int
  userId    String
  createdAt DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([diaryId, userId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  diaryId   Int
  userId    String
  createdAt DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}